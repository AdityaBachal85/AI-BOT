# Copy this file to ".env" and fill it in. Keep .env private: it holds the admin password.

# ---------------------------------------------------------------------------
# 1. Your company
# ---------------------------------------------------------------------------
# Used inside the assistants' instructions ("You work for ...").
COMPANY_NAME="Your Company Name"

# Name shown in the browser. Open WebUI adds "(Open WebUI)" after it; see README > Licence.
BOT_NAME="Company AI"

# ---------------------------------------------------------------------------
# 2. First admin account (created automatically on the very first start)
# ---------------------------------------------------------------------------
ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-this-password

# Any long random text (40+ characters). It signs login sessions.
# Generate one with:  openssl rand -hex 32   (or just mash the keyboard)
WEBUI_SECRET_KEY=

# ---------------------------------------------------------------------------
# 3. Hardware: where the AI model runs
# ---------------------------------------------------------------------------
#   cpu     any Windows/Linux PC or server, no graphics card needed (slower)
#   nvidia  PC/server with an NVIDIA graphics card (much faster)
#   (empty) Ollama is installed directly on this computer, e.g. a Mac.
#           Also set OLLAMA_URL=http://host.docker.internal:11434 below.
COMPOSE_PROFILES=cpu

# Leave as is unless you use your own Ollama install (see above).
OLLAMA_URL=http://ollama:11434

# ---------------------------------------------------------------------------
# 4. AI models (free, open models from https://ollama.com/library)
# ---------------------------------------------------------------------------
# Model behind the four assistants. Pick by the machine's memory (see README > Models):
#   gemma4:e4b   16 GB RAM, no graphics card     (default, ~10 GB download)
#   gemma4:12b   12 GB+ graphics card or Mac 24 GB+
#   gemma4:26b   24 GB+ graphics card or Mac 48 GB+
CHAT_MODEL=gemma4:e4b

# Extra models staff can pick directly from the model menu, comma-separated.
# Each is another download and needs 5-10 GB of memory while someone is using it.
# Leave empty for none. Sizes that fit a 16 GB machine:
#   qwen3.5:9b       Qwen 3.5       strong all-rounder, 256K context      ~6 GB
#   llama3.1:8b      Llama 3.1      Meta's small model                    ~5 GB
#   mistral:7b       Mistral 7B     fast and concise                      ~4 GB
#   deepseek-r1:8b   DeepSeek-R1    "thinking" model, shows its reasoning ~5 GB
# Bigger, for a 24 GB+ graphics card: qwen3.6:27b, mistral-small3.2:24b, deepseek-r1:32b
EXTRA_MODELS=qwen3.5:9b,llama3.1:8b,mistral:7b,deepseek-r1:8b

# How many models stay loaded in memory at the same time. Keep 1 on a CPU-only or
# 16 GB machine. With a 24 GB+ graphics card, 2 lets two models answer without reloading.
OLLAMA_MAX_LOADED_MODELS=1

# Small model that turns documents into searchable vectors. Supports 100+ languages.
EMBEDDING_MODEL=embeddinggemma

# How much text the model can read at once (tokens). Higher = more memory.
CONTEXT_LENGTH=8192

# Assistant selected by default when someone opens a new chat.
# One of: company-knowledge, writing-assistant, sales-assistant, general-assistant
DEFAULT_ASSISTANT=company-knowledge

# ---------------------------------------------------------------------------
# 5. Network
# ---------------------------------------------------------------------------
# Staff open http://<this-computer's-IP>:PORT in their browser.
PORT=3000
